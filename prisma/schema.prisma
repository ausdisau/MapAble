enum CareRecurringScheduleStatus {
  draft
  active
  paused
  ended
}

enum CareScheduleExceptionType {
  skip
  reschedule
}

/// Recurring Care cadence for a booking. Agreement SoT remains CareServiceAgreement.
model CareRecurringSchedule {
  id             String                      @id @default(cuid())
  careBookingId  String
  careBooking    CareBooking                 @relation(fields: [careBookingId], references: [id], onDelete: Cascade)
  participantId  String
  organisationId String
  /// weekly | fortnightly
  frequency      String
  /// ISO weekdays 1=Mon .. 7=Sun
  byWeekday      Int[]
  startTimeLocal String
  endTimeLocal   String
  timezone       String                      @default("Australia/Sydney")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         CareRecurringScheduleStatus @default(draft)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  exceptions CareRecurringScheduleException[]
  shifts     CareShift[]

  @@index([careBookingId, status])
  @@index([participantId])
  @@map("care_recurring_schedules")
}

model CareRecurringScheduleException {
  id             String                    @id @default(cuid())
  scheduleId     String
  schedule       CareRecurringSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

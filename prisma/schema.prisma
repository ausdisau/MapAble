/// Purpose-bound receipt for sensitive participant-data access (Trust Fabric).
/// Categories only — never stores raw secrets or model chain-of-thought.
model ParticipantAccessReceipt {
  id               String   @id @default(cuid())
  participantId    String
  participant      User     @relation("AccessReceiptParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  actorUserId      String?
  actorUser        User?    @relation("AccessReceiptActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organisationId   String?
  organisation     Organisation? @relation("AccessReceiptOrganisation", fields: [organisationId], references: [id], onDelete: SetNull)
  purpose          String
  fieldCategories  String[] @default([])
  authoritySource  String
  authorityRef     String?
  consentRecordId  String?
  expiresAt        DateTime?
  correlationId    String
  outcome          String
  challengedAt     DateTime?
  challengeNote    String?
  createdAt        DateTime @default(now())

  @@index([participantId, createdAt])
  @@index([correlationId])
  @@index([actorUserId, createdAt])
  @@map("participant_access_receipts")
}

/// Durable break-glass session with after-action review requirement.
model BreakGlassAccessSession {
  id                 String    @id @default(cuid())
  adminUserId        String
  adminUser          User      @relation("BreakGlassOpenedBy", fields: [adminUserId], references: [id], onDelete: Cascade)
  purpose            String
  reason             String
  organisationId     String?
  participantId      String?
  fieldCategories    String[]  @default([])
  openedAt           DateTime  @default(now())
  expiresAt          DateTime
  ticketRef          String?
  afterActionRequired Boolean  @default(true)
  afterActionCompletedAt DateTime?
  afterActionNote    String?
  revokedAt          DateTime?
  correlationId      String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([adminUserId, expiresAt])
  @@index([participantId])
  @@index([correlationId])
  @@map("break_glass_access_sessions")
}

/// Consequential deterministic decision notice (explainable, challengeable).

/// Connected account recipient for Stripe transfers (not bank payout — Stripe handles external payout).
model PayoutRecipient {
  id                    String                            @id @default(cuid())
  userId                String?
  user                  User?                             @relation("PayoutRecipients", fields: [userId], references: [id], onDelete: SetNull)
  providerOrgId         String?
  providerOrg           Organisation?                     @relation("OrganisationPayoutRecipients", fields: [providerOrgId], references: [id], onDelete: SetNull)
  workerId              String?
  worker                WorkerProfile?                    @relation("WorkerPayoutRecipients", fields: [workerId], references: [id], onDelete: SetNull)
  recipientType         PayoutRecipientType
  displayName           String
  email                 String
  stripeAccountId       String?                           @unique
  stripeAccountApiVersion StripeAccountApiVersion         @default(unknown)
  stripeDashboardType   StripeDashboardType               @default(unknown)
  stripeOnboardingStatus StripeOnboardingStatus           @default(not_started)
  chargesEnabled        Boolean                           @default(false)
  payoutsEnabled        Boolean                           @default(false)
  transfersEnabled      Boolean                           @default(false)
  requirementsDue       Json                              @default("[]")
  defaultCurrency       String                            @default("AUD")
  country               String                            @default("AU")
  payoutSchedule        PayoutSchedule                    @default(unknown)
  verificationStatus    PayoutRecipientVerificationStatus @default(unverified)
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  paymentSplits   BillingPaymentSplit[]
  payoutTransfers PayoutTransfer[]

  @@index([userId])
  @@index([providerOrgId])
  @@index([workerId])
  @@index([stripeAccountId])
  @@index([recipientType])
}

/// Batch of approved payout splits processed together.
model PayoutBatch {
  id                   String            @id @default(cuid())
  batchNumber          String            @unique
  status               PayoutBatchStatus @default(draft)
  totalGrossCents      Int               @default(0)
  totalNetTransferCents Int              @default(0)
  approvedByUserId     String?
  approvedAt           DateTime?
  processedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  transfers PayoutTransfer[]

  @@index([status])
  @@index([createdAt])
}

/// Stripe Transfer record — money moved from platform balance to connected account (not bank deposit).
model PayoutTransfer {
  id              String               @id @default(cuid())
  payoutSplitId   String
  payoutSplit     BillingPaymentSplit  @relation(fields: [payoutSplitId], references: [id], onDelete: Cascade)
  payoutBatchId   String?
  payoutBatch     PayoutBatch?         @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  recipientId     String
  recipient       PayoutRecipient      @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  stripeTransferId String?             @unique
  amountCents     Int
  currency        String               @default("AUD")
  status          PayoutTransferStatus @default(pending)
  failureCode     String?
  failureMessage  String?
  transferGroup   String?
  idempotencyKey  String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([payoutSplitId])
  @@index([payoutBatchId])
  @@index([recipientId])
  @@index([transferGroup])
  @@index([status])
}

/// Active hold blocking payout release for a payment or split.
model PayoutBlock {
  id            String              @id @default(cuid())
  paymentId     String
  payment       BillingPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       BillingInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payoutSplitId String?
  payoutSplit   BillingPaymentSplit?  @relation(fields: [payoutSplitId], references: [id], onDelete: SetNull)
  reason        PayoutBlockReason
  severity      PayoutBlockSeverity @default(warning)
  status        PayoutBlockStatus   @default(active)
  createdBy     String?
  resolvedBy    String?
  notes         String?
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([paymentId, status])
  @@index([payoutSplitId])
  @@index([invoiceId])
}

/// Accounting export batch for reconciliation (CSV / Xero-ready).
model AccountingExport {
  id             String                   @id @default(cuid())

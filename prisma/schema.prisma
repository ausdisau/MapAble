  status          ParticipantAuthorityGrantStatus @default(active)
  consentRecordId String?
  expiresAt       DateTime?
  createdById     String
  createdBy       User                            @relation("AuthorityGrantCreatedBy", fields: [createdById], references: [id])
  revokedById     String?
  revokedBy       User?                           @relation("AuthorityGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
  correlationId   String                          @default(cuid())
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([participantId, status])
  @@index([granteeUserId])
  @@index([expiresAt])
  @@map("participant_authority_grants")
}

model NavigatorOrganisation {
  id             String   @id @default(cuid())
  organisationId String   @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  displayName    String
  description    String?
  visibility     NavigatorVisibility @default(community)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  navigators NavigatorProfile[]
  assignments NavigatorAssignment[] @relation("NavigatorAssignmentOrganisation")

  @@map("navigator_organisations")
}

model NavigatorProfile {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation("NavigatorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  navigatorOrganisationId String?
  navigatorOrganisation   NavigatorOrganisation? @relation(fields: [navigatorOrganisationId], references: [id], onDelete: SetNull)
  displayName             String
  bio                     String?
  visibility              NavigatorVisibility @default(public)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  specialisms              NavigatorSpecialism[]
  availability             NavigatorAvailability[]
  regions                  NavigatorRegion[]
  languages                NavigatorLanguage[]
  communicationCapabilities NavigatorCommunicationCapability[]
  credentialReferences     NavigatorCredentialReference[]
  assignments              NavigatorAssignment[]

  @@index([userId])
  @@index([isActive, visibility])
  @@map("navigator_profiles")
}

model NavigatorSpecialism {
  id          String           @id @default(cuid())
  navigatorId String
  navigator   NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  specialism  String
  createdAt   DateTime         @default(now())

  @@index([navigatorId])
  @@map("navigator_specialisms")
}

model NavigatorAvailability {
  id          String           @id @default(cuid())
  navigatorId String
  navigator   NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  timezone    String           @default("Australia/Sydney")
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([navigatorId])
  @@map("navigator_availability")
}

model NavigatorRegion {
  id          String           @id @default(cuid())
  navigatorId String
  navigator   NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  regionCode  String
  regionName  String
  createdAt   DateTime         @default(now())

  @@index([navigatorId, regionCode])
  @@map("navigator_regions")
}

model NavigatorLanguage {
  id          String           @id @default(cuid())
  navigatorId String
  navigator   NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  languageCode String
  proficiency  String          @default("fluent")
  createdAt   DateTime         @default(now())

  @@index([navigatorId])
  @@map("navigator_languages")
}

model NavigatorCommunicationCapability {
  id          String           @id @default(cuid())
  navigatorId String
  navigator   NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  mode        String
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([navigatorId])
  @@map("navigator_communication_capabilities")
}

model NavigatorCredentialReference {
  id             String           @id @default(cuid())
  navigatorId    String
  navigator      NavigatorProfile @relation(fields: [navigatorId], references: [id], onDelete: Cascade)
  credentialType String
  issuer         String?
  referenceId    String?
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([navigatorId])
  @@map("navigator_credential_references")
}

model NavigatorRequest {
  id              String                 @id @default(cuid())
  participantId   String
  participant     User                   @relation("NavigatorRequestParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  missionId       String?
  caseId          String?
  status          NavigatorRequestStatus @default(draft)
  goalSummary     String
  sharedFields    String[]               @default([])
  preferredModes  String[]               @default([])
  correlationId   String                 @default(cuid())
  approvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  assignments NavigatorAssignment[]

  @@index([participantId, status])
  @@map("navigator_requests")
}

model NavigatorAssignment {
  id                    String                    @id @default(cuid())
  requestId             String
  request               NavigatorRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  participantId         String
  participant           User                      @relation("NavigatorAssignmentParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  navigatorId           String
  navigator             User                      @relation("NavigatorAssignmentNavigator", fields: [navigatorId], references: [id], onDelete: Cascade)
  navigatorProfileId    String?
  navigatorProfile      NavigatorProfile?         @relation(fields: [navigatorProfileId], references: [id], onDelete: SetNull)
  navigatorOrganisationId String?
  navigatorOrganisation NavigatorOrganisation?    @relation("NavigatorAssignmentOrganisation", fields: [navigatorOrganisationId], references: [id], onDelete: SetNull)
  status                NavigatorAssignmentStatus @default(pending)
  sharedFields          String[]                  @default([])
  participantApprovedAt DateTime?
  correlationId         String                    @default(cuid())
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  handovers NavigatorHandover[]
  outcomes  NavigatorOutcome[]
  feedback  NavigatorFeedback[]

  @@index([participantId, status])
  @@index([navigatorId, status])
  @@map("navigator_assignments")
}

model NavigatorHandover {
  id             String              @id @default(cuid())
  assignmentId   String
  assignment     NavigatorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromNavigatorId String
  fromNavigator  User                @relation("NavigatorHandoverFrom", fields: [fromNavigatorId], references: [id])
  toNavigatorId  String
  toNavigator    User                @relation("NavigatorHandoverTo", fields: [toNavigatorId], references: [id])
  sharedFields   String[]            @default([])
  summary        String
  participantApprovedAt DateTime?
  createdAt      DateTime            @default(now())

  @@index([assignmentId])
  @@map("navigator_handovers")
}

model NavigatorOutcome {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   NavigatorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  summary      String
  outcomeJson  Json                @default("{}")
  recordedAt   DateTime            @default(now())

  @@index([assignmentId])
  @@map("navigator_outcomes")
}

model NavigatorFeedback {
  id             String              @id @default(cuid())
  assignmentId   String
  assignment     NavigatorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  participantId  String
  participant    User                @relation("NavigatorFeedbackParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  rating         Int?
  comment        String?
  createdAt      DateTime            @default(now())

  @@index([assignmentId])
  @@map("navigator_feedback")
}

model ServiceRelationshipRecord {
  id                String   @id @default(cuid())
  participantId     String
  participant       User     @relation("TrustRelationshipParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  providerOrganisationId String?
  providerOrganisation Organisation? @relation("TrustRelationshipProvider", fields: [providerOrganisationId], references: [id], onDelete: SetNull)
  platformOrganisationId String?
  platformOrganisation Organisation? @relation("TrustRelationshipPlatform", fields: [platformOrganisationId], references: [id], onDelete: SetNull)
  bookingId         String?
  careRequestId     String?
  title             String
  summary           String?
  correlationId     String   @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  roleDisclosures ServiceRoleDisclosure[]
  snapshots       TrustRelationshipSnapshot[]

  @@index([participantId])
  @@map("service_relationship_records")
}

model ServiceRoleDisclosure {
  id              String                  @id @default(cuid())
  relationshipId  String
  relationship    ServiceRelationshipRecord @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  role            ServiceRelationshipRole
  organisationName String?
  description     String
  isMapAble       Boolean                 @default(false)
  paymentPathway  String?
  complaintPathway String?
  insuranceNotes  String?
  credentialChecked Boolean               @default(false)
  credentialNotes String?
  conflictFlag    Boolean                 @default(false)
  consentRecordId String?
  createdAt       DateTime                @default(now())

  @@index([relationshipId])
  @@map("service_role_disclosures")
}

model TrustRelationshipSnapshot {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   ServiceRelationshipRecord @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  status         TrustSnapshotStatus @default(active)
  feeComponentsJson Json             @default("[]")
  quoteSnapshotJson Json?
  agreementSnapshotJson Json?
  invoiceSnapshotJson Json?
  disclosureJson Json                @default("{}")
  informationalOnly Boolean           @default(true)
  correlationId  String              @default(cuid())
  capturedAt     DateTime            @default(now())

  @@index([relationshipId, status])
  @@map("trust_relationship_snapshots")
}

// ---------------------------------------------------------------------------
// Assistive Technology Continuity (NDIS Expansion Wave 1)
// Equipment continuity register — not clinical suitability SoT.
// Flag: MAPABLE_AT_CONTINUITY_ENABLED (default false).
// ---------------------------------------------------------------------------

enum AtEquipmentCategory {
  mobility
  communication
  daily_living
  other
}

enum AtOutageStatus {
  draft
  reported
  active
  resolved
  closed
  withdrawn
}

enum AtDependencyTargetType {
  care_request
  transport_trip
  transport_trip_request
  job
  job_application
  calendar_event
}

model AtEquipmentAsset {
  id                      String              @id @default(cuid())
  participantUserId       String
  participant             User                @relation("AtEquipmentAssetParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  displayName             String
  category                AtEquipmentCategory
  mobilityAidHint         String?
  marketplaceCategoryHint String?
  externalAssessmentRef   String?
  notes                   String?
  active                  Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  outages       AtEquipmentOutage[]
  backupPlans   AtBackupPlan[]
  repairPartners AtRepairPartnerRef[]
  dependencies  AtDependencyLink[]

  @@index([participantUserId, active])
  @@index([participantUserId, category])
  @@map("at_equipment_assets")
}

model AtEquipmentOutage {
  id                String         @id @default(cuid())
  assetId           String
  asset             AtEquipmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  participantUserId String
  participant       User           @relation("AtEquipmentOutageParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  summary           String
  status            AtOutageStatus @default(reported)
  impactNotes       String?
  reportedAt        DateTime       @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([assetId, status])
  @@index([participantUserId, status])
  @@map("at_equipment_outages")
}

model AtBackupPlan {
  id                String   @id @default(cuid())
  assetId           String
  asset             AtEquipmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  participantUserId String
  participant       User     @relation("AtBackupPlanParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  title             String
  instructions      String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assetId, active])
  @@index([participantUserId])
  @@map("at_backup_plans")
}

model AtRepairPartnerRef {
  id                 String   @id @default(cuid())
  assetId            String
  asset              AtEquipmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  participantUserId  String
  participant        User     @relation("AtRepairPartnerRefParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  organisationId     String
  organisation       Organisation @relation("AtRepairPartnerOrganisation", fields: [organisationId], references: [id], onDelete: Cascade)
  externalPartnerRef String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([assetId])
  @@index([participantUserId])
  @@index([organisationId])
  @@map("at_repair_partner_refs")
}

model AtDependencyLink {
  id                String                 @id @default(cuid())
  assetId           String
  asset             AtEquipmentAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  participantUserId String
  participant       User                   @relation("AtDependencyLinkParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  targetType        AtDependencyTargetType
  targetEntityId    String
  notes             String?
  createdAt         DateTime               @default(now())

  @@index([assetId, targetType])
  @@index([participantUserId])
  @@index([targetType, targetEntityId])
  @@map("at_dependency_links")
}


  booking                 Booking?         @relation("BookingTransportTrip")
  rideRunId               String?
  rideRun                 RideRun?         @relation(fields: [rideRunId], references: [id], onDelete: SetNull)

  @@index([participantId, status])
  @@index([providerOrganisationId, status])
  @@index([rideRunId])
  @@index([scheduledStart])
  @@map("transport_trips")
}


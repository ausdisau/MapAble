  type           CareScheduleExceptionType
  newStartAt     DateTime?
  newEndAt       DateTime?
  reason         String?
  createdAt      DateTime                  @default(now())

  @@unique([scheduleId, occurrenceDate])
  @@map("care_recurring_schedule_exceptions")
}


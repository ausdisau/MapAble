// Worker model — ADD these fields if not already present:
//   abn         String?
//   abnVerified Boolean @default(false)

// Invoice model — ADD these fields if not already present:
//   qbInvoiceId     String?
//   qbSyncStatus    String?    // "pending" | "syncing" | "synced" | "error"
//   qbSyncError     String?
//   qbLastSyncedAt  DateTime?
//   orbGenerated    Boolean  @default(false)

// =============================================================================
// New models
// =============================================================================

model BecsMandate {
  id                     String    @id @default(cuid())
  userId                 String
  stripePaymentMethodId  String    @unique
  stripeMandateId        String?
  status                 String    @default("pending")
  // "pending" | "active" | "cancelled" | "expired"
  accountBsb             String?
  accountLast4           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model NdisPlanCache {
  id            String    @id @default(cuid())
  participantId String    @unique
  planData      Json
  goals         Json
  fetchedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model NdisClaim {
  id               String    @id @default(cuid())
  invoiceId        String?
  serviceSessionId String?
  participantId    String
  providerId       String
  prodaClaimId     String?
  claimReference   String    @unique
  itemCode         String
  quantity         Float
  unitPrice        Float
  totalAmount      Float
  serviceDate      String
  status           String    // "submitted" | "accepted" | "rejected"
  statusMessage    String?
  rejectionReason  String?
  requestPayload   Json?
  responsePayload  Json?
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([participantId])
  @@index([providerId])
  @@index([status])
  @@index([submittedAt])
}

model GroceryProduct {
  id                String    @id @default(cuid())
  name              String
  brand             String?
  category          String    // GroceryCategory enum value as string
  price             Decimal   @db.Decimal(10, 2)
  unit              String
  description       String?
  image             String?
  inStock           Boolean   @default(true)
  supplierSource    String    @default("seed")
  supplierProductId String    @unique
  supplierUrl       String?
  priceSource       String    @default("manual") // "manual" | "supplier" | "estimated"
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItems        GroceryOrderItem[]

  @@index([category])
  @@index([supplierSource])
  @@index([lastSyncedAt])
}

model GroceryOrder {
  id                    String    @id @default(cuid())
  participantId         String
  status                String    @default("placed")
  // "placed" | "confirmed" | "shopping" | "out_for_delivery" | "delivered" | "cancelled"
  deliveryAddress       String
  deliveryTimePreference String?
  accessNeeds           String?
  deliveryNotes         String?
  totalAmount           Decimal   @db.Decimal(10, 2)
  stripePaymentIntentId String?
  paymentStatus         String    @default("unpaid")
  workerId              String?
  shoppingList          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  participant           User      @relation("GroceryOrderParticipant", fields: [participantId], references: [id])
  items                 GroceryOrderItem[]

  @@index([participantId])
  @@index([status])
}

model GroceryOrderItem {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  order     GroceryOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   GroceryProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// -----------------------------------------------------------------------------
// Chat guardrail tables
// -----------------------------------------------------------------------------

model ChatGuardrailAuditLog {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String?
  turnIndex    Int       @default(0)
  inputSnippet String    @db.Text
  categories   String[]
  actions      String[]
  policyRefs   String[]
  blocked      Boolean   @default(false)
  outputBlocked Boolean  @default(false)
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model SafeguardingConcernFlag {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String?
  categories   String[]
  inputSnippet String    @db.Text
  severity     String    // "critical" | "high" | "medium" | "low"
  status       String    @default("open") // "open" | "under_review" | "resolved" | "escalated"
  smsAlertSent Boolean   @default(false)
  reviewerId   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([sessionId])
  @@index([createdAt])
}

model SafeguardingIncidentDraft {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String?
  incidentType String
  description  String    @db.Text
  inputSnippet String    @db.Text
  severity     String    // "critical" | "high" | "medium" | "low"
  status       String    @default("draft") // "draft" | "submitted" | "closed"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sessionId])
  @@index([status])
}

model SafeguardingComplaintDraft {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String?
  description  String    @db.Text
  inputSnippet String    @db.Text
  status       String    @default("draft")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sessionId])
  @@index([status])
}

model SafeguardingConsentRecord {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String?
  decision     String    // "withdrawn" | "granted" | "clarified"
  scope        String
  inputSnippet String    @db.Text
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([decision])
}

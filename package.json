    "audit:branch-protection": "node scripts/ci/audit-branch-protection-readonly.mjs",
    "audit:deploy-evidence": "node scripts/ci/capture-deployment-evidence-readonly.mjs",
    "audit:human-release-evidence": "node scripts/ci/validate-human-release-evidence-readonly.mjs",
    "setup:cloud-agent": "bash scripts/setup-cloud-agent.sh",
    "mcp:av": "tsx mcp/av/server.ts",
    "neon:configure": "python3 scripts/configure-neon-env.py",
    "seed:ndis-service-delivery": "tsx prisma/seed-ndis-service-delivery.ts",
    "import:provider-outlets-supabase": "tsx scripts/import-provider-outlets-supabase.ts",
    "fetch:ndis-list-providers": "tsx scripts/fetch-ndis-list-providers.ts",
    "seed:ndis-provider-outlets": "tsx prisma/seed-ndis-provider-outlets.ts",
    "seed:billing-centre": "tsx prisma/seed-billing-centre.ts",
    "seed:a11y-pilot": "tsx prisma/seed-a11y-pilot.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "predeploy:billing": "prisma migrate deploy && prisma generate",
    "ingest:ndis-providers": "tsx scripts/ingest-ndis-providers.ts",
    "ingest:ndis-providers:dry": "DRY_RUN=true tsx scripts/ingest-ndis-providers.ts",
    "check:integrations-env": "npx tsx scripts/check-integrations-env.ts",
    "check:convergence-advisory": "npx tsx scripts/convergence-advisory-ci.ts",
    "sync:mapable-adl-kml": "python3 scripts/sync-mapable-adl-kml.py",
    "sync:replit-unified": "bash scripts/sync-replit-unified.sh",
    "check:replit-unified": "bash scripts/check-replit-unified-deployment.sh",
    "test:access-intelligence-next": "vitest run tests/access-intelligence-next",
    "test:trust-fabric": "vitest run tests/trust-fabric",
    "ai:evals": "tsx scripts/ai-platform/run-evals.ts",
    "test:ai-platform": "vitest run tests/ai-platform"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]

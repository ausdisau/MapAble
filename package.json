{
  "name": "MapableAU",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "node scripts/run-next-build.mjs",
    "start": "next start",
    "lint": "NODE_OPTIONS='--max-old-space-size=6144' eslint app components lib schemas scripts/ci --max-warnings 0",
    "lint:tests": "NODE_OPTIONS='--max-old-space-size=6144' eslint tests --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check \"scripts/ci/**/*.{ts,tsx,md}\" \"docs/remediation/**/*.md\" \"docs/operations/branch-protection.md\" \".github/workflows/**/*.{yml,yaml}\" \"tests/a11y/**/*.{ts,tsx}\" \"next.config.ts\" \"package.json\" \"playwright.config.ts\" \"README.md\"",
    "format:check:all": "prettier --check .",
    "lint:fix": "NODE_OPTIONS='--max-old-space-size=6144' eslint app components lib schemas scripts/ci --fix",
    "prepare": "husky install && prisma generate",
    "lint-staged": "lint-staged",
    "prepush": "pnpm type-check && pnpm format:check && pnpm lint && pnpm lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:csp-enforce": "playwright test -c playwright.csp.config.ts",
    "build:csp-enforce": "MAPABLE_CSP_ENFORCE_PREVIEW=true pnpm build",
    "test:e2e:starting-work": "playwright test -c playwright.e2e.config.ts",
    "preview:csp-perf-matrix": "node scripts/preview/csp-performance-matrix.mjs",

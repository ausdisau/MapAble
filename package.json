{
  "name": "mapable-unified",
  "version": "1.0.0",
  "private": true,
  "description": "Unified MapAble repository containing the MapAble web platform and AdaptAble/Independence Suite mobile app.",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "test:web": "pnpm --dir apps/web test",
    "lint:web": "pnpm --dir apps/web lint",
    "typecheck:web": "pnpm --dir apps/web type-check",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:mobile:tunnel": "npm --prefix apps/mobile run start:tunnel",
    "mobile:web": "npm --prefix apps/mobile run web",
    "build:mobile-web": "npm --prefix apps/mobile run build:web",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck"
  },
  "packageManager": "pnpm@10.12.1"
}

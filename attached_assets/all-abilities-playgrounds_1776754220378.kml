    <Placemark id="ID_00001">
      <name>Anzac Park All Abilities Playground</name>
      <Snippet></Snippet>
      <description><![CDATA[<html xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:msxsl="urn:schemas-microsoft-com:xslt">

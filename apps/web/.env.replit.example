# Copy to `.env.replit` (gitignored) and fill in values.
# Used by `npm run dev:replit` / `test:replit` in Cursor — no Replit Secrets required.
#
#   cp .env.replit.example .env.replit
#
# --- Mode A: UI-only (no database) ---
# Leave DATABASE_URL unset (run-replit.sh uses an offline placeholder and skips seed).
# MAPABLE_REPLIT_OFFLINE=1

# --- Mode B: Supabase Postgres (recommended while Replit credits are empty) ---
# From Supabase → Project Settings → Database → Connection string (URI).
# Host alone is not enough — include user, password, port, db, sslmode.
#
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.louioyirfyzdjshmremy.supabase.co:5432/postgres?sslmode=require
# Or Supabase pooler (port 6543), if you use it:
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

SESSION_SECRET=replace-me-with-a-long-random-string

# Optional integrations (placeholders keep the server from crashing on import)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

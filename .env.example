# PostgreSQL — local default; for Neon see docs/operations/neon.md
DATABASE_URL="postgresql://user:password@localhost:5432/mapable"
# Same as DATABASE_URL for local dev; for Neon use the *non-pooler* endpoint
DIRECT_URL="postgresql://user:password@localhost:5432/mapable"

# Neon example (from console.neon.tech → Connect):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Passkeys / WebAuthn (optional overrides; defaults derive from NEXTAUTH_URL)
PASSKEY_ORIGIN=
PASSKEY_RP_ID=

# Twilio Verify 2FA (optional — applies to email/password login when enabled)
TWILIO_2FA_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OAuth sign-in (optional — buttons appear only when required provider vars are set)
# Auth0 → Application → redirect: {NEXTAUTH_URL}/api/auth/callback/auth0
# Configure Google/Facebook as Auth0 social connections in the Auth0 dashboard.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER_BASE_URL=
# Google Cloud Console → OAuth client → redirect: {NEXTAUTH_URL}/api/auth/callback/google
# Use GOOGLE_CLIENT_ID, GOOGLE_ID, or AUTH_GOOGLE_ID (same value);
# secret: GOOGLE_CLIENT_SECRET, GOOGLE_SECRET, or AUTH_GOOGLE_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → Facebook Login → redirect: {NEXTAUTH_URL}/api/auth/callback/facebook
# Use FACEBOOK_CLIENT_ID or FACEBOOK_APP_ID (same value); secret: FACEBOOK_CLIENT_SECRET or FACEBOOK_APP_SECRET
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Microsoft Entra / Azure AD → App registration → redirect: {NEXTAUTH_URL}/api/auth/callback/azure-ad
# AZURE_AD_TENANT_ID: "common" (default) for work + personal Microsoft accounts; or your tenant GUID
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
# Apple Developer → Sign in with Apple → Services ID + key
# Redirect: {NEXTAUTH_URL}/api/auth/callback/apple
# APPLE_ID or APPLE_CLIENT_ID = Services ID; private key as single line with \n escapes
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Or supply a pre-generated JWT (rotates every ~6 months): APPLE_SECRET=
# Password reset emails (optional in local dev — reset link is logged to the server console)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@example.com"
# Contact form inbox (defaults to SENDGRID_FROM_EMAIL, then support@mapable.com.au)
MAPABLE_CONTACT_INBOX=
# Dedicated field encryption (NDIS numbers / sensitive identifiers).
# NEVER reuse NEXTAUTH_SECRET. Min 16 characters. Required unless MAPABLE_ALLOW_DEV_ENCRYPTION_FALLBACK=true in local/test.
NDIS_ENCRYPTION_KEY="change-me-in-production-min-16-chars"
# Optional alias for the same dedicated material:
# MAPABLE_DATA_ENCRYPTION_KEY=
MAPABLE_ENCRYPTION_KEY_VERSION="v1"
# Local/test only — never enable in production/preview:
MAPABLE_ALLOW_DEV_ENCRYPTION_FALLBACK="true"
# When true (default in production), mapable_admin org access requires /api/admin/break-glass
MAPABLE_REQUIRE_ADMIN_BREAK_GLASS="false"

# Trust Fabric — purpose-bound access receipts + participant history (default off — internal alpha)
MAPABLE_TRUST_FABRIC_ENABLED="false"
MAPABLE_PARTICIPANT_ACCESS_HISTORY_ENABLED="false"

# Communication Passport + Workforce readiness (default off — not production)
MAPABLE_COMMUNICATION_PASSPORT_ENABLED="false"
MAPABLE_WORKFORCE_READINESS_ENABLED="false"

# Native Companion foundation (default off — Expo app under apps/companion)
MAPABLE_COMPANION_ENABLED="false"
MAPABLE_COMPANION_VISIT_PACK_ENABLED="false"

# Provider Operations read-only attention queue (default off)
MAPABLE_PROVIDER_OPS_ENABLED="false"

# Recurring Care schedules (default off)
MAPABLE_CARE_RECURRING_SCHEDULES_ENABLED="false"

# Starting Work controlled pilot — Taylor @ Harbour Civic Centre (synthetic)
MAPABLE_STARTING_WORK_PILOT_ENABLED="false"
MAPABLE_STARTING_WORK_SYNTHETIC_ONLY="true"
# Persist StartingWorkJourneyProjection (temporary — not CareOSMission SoR)
MAPABLE_STARTING_WORK_DB_PERSISTENCE_ENABLED="false"

# Search autocomplete (Postgres):
# npx prisma db execute --schema prisma/schema.prisma --file prisma/sql/ensure-search-autocomplete.sql
# npx tsx prisma/seed-search-autocomplete.ts

# Australia Post PAC — suburb/postcode location suggestions (server-side AUTH-KEY)
# Add to Vercel Production + Preview; redeploy after changing.
AUSPOST_PAC_API_KEY=
AUSPOST_PAC_ENABLED=true
AUSPOST_PAC_CACHE_TTL_SECONDS=3600

# Governed AI platform foundation (default off — registry/gateway for new call sites)
MAPABLE_AI_PLATFORM_ENABLED=false
MAPABLE_AI_MODEL_GENERATION_ENABLED=false
MAPABLE_AI_SHADOW_EVAL_ENABLED=false
MAPABLE_AI_CONTROLLED_PILOT_ENABLED=false
MAPABLE_AI_PUBLIC_CLAIM_ENABLED=false
MAPABLE_AI_GLOBAL_KILL_SWITCH=false

# AI Evidence Intake Studio (review-first; default off — no OCR, no canonical writes)
MAPABLE_AI_INTAKE_ENABLED=false
MAPABLE_AI_INTAKE_MODEL_ENABLED=false
MAPABLE_AI_INTAKE_CANONICAL_WRITE_ENABLED=false

# Mission Evidence Graph + hybrid retrieval (Starting Work only; default off)
MAPABLE_MISSION_GRAPH_ENABLED=false
MAPABLE_SEMANTIC_RETRIEVAL_ENABLED=false
MAPABLE_EMBEDDINGS_ENABLED=false

# Edge AI Capability Broker (local-first Companion; default off — no App Store AI claim)
MAPABLE_EDGE_AI_ENABLED=false
MAPABLE_ON_DEVICE_AI_ENABLED=false
MAPABLE_CLOUD_AI_FALLBACK_ENABLED=false

# Mission Portfolio shared projection (read-only; default off)
MAPABLE_MISSION_PORTFOLIO_ENABLED=false
MAPABLE_SERVICE_STANDARD_ENABLED=false
MAPABLE_WHAT_CHANGED_ENABLED=false
MAPABLE_MISSION_COPILOT_ENABLED=false
MAPABLE_MISSION_COPILOT_MODEL_ENABLED=false
MAPABLE_CASE_COPILOT_ENABLED=false
MAPABLE_BILLING_EVIDENCE_COPILOT_ENABLED=false

# Natural-language search interpreter (server-only; Vercel AI Gateway or Google)
SEARCH_INTERPRETER_ENABLED=true
AI_GATEWAY_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
SEARCH_INTERPRETER_MODEL=google/gemini-3.5-flash
# Dedicated LLM step when access text is set but keyword needs resolution is empty (default on when interpreter keys exist)
SEARCH_NEEDS_INTERPRETER_LLM=true
# Provider Finder agent (interpret → search ndis_providers → reply)
SEARCH_AGENT_ENABLED=false
# AI SDK ToolLoopAgent for agentic disability services (POST /api/agent/disability-services)
DISABILITY_SERVICES_AGENT_ENABLED=false
DISABILITY_SERVICES_AGENT_MAX_STEPS=6
# Auth-scoped booking RAG + ToolLoopAgent (POST /api/agent/booking-services)
BOOKING_SERVICES_AGENT_ENABLED=false
BOOKING_SERVICES_AGENT_MAX_STEPS=6
# Booking RAG retrieval (hybrid TF + filters; no OpenSearch required for v1)
BOOKING_RAG_ENGINE_ID=hybrid-v1
BOOKING_RAG_RESULT_LIMIT=8
BOOKING_RAG_SNAPSHOT_LIMIT=100
PROVIDER_FINDER_AUTO_SHOW_RESULTS=false
PROVIDER_FINDER_AUTO_SHOW_MIN_CONFIDENCE=0.75
PROVIDER_FINDER_RESULTS_LIMIT=8
# Optional HF slug classifier after training (docs/search/hf-category-classifier.md)
# SEARCH_INTERPRETER_CLASSIFIER_HUB_ID=
# HF_TOKEN=
# Chat SDK — optional Slack finder bot (POST /api/chat/slack)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Elasticsearch service category replica (phase 2 — docs/search/elasticsearch-service-categories.md)
# ES_URL=
# ES_API_KEY=
# ES_SERVICE_CATEGORY_ALIAS=mapable_service_categories_current
NEXT_PUBLIC_PRODUCT_ANALYTICS_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Google AdSense (ca-pub-4510603272878761). Loaded in production only; set false to disable.
# NEXT_PUBLIC_ADSENSE_ENABLED=false

# Storage
DOCUMENT_STORAGE_MODE=local
DOCUMENT_MAX_UPLOAD_MB=10

